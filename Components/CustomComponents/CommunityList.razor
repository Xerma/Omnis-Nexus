@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject CommunityStateService CommunityState
@inject IPermissionService PermService
@inject MemberReportService MemRepService

@if (CommunityState.UserCommunities.Any())
{
    <div class="cl-container">
    @foreach (var community in CommunityState.UserCommunities)
    {
        <a href="@($"/channels/{community.Id}")"
               class="community-list-item @(community.Id == ActiveCommunityId ? "active" : "")"
               @oncontextmenu:preventDefault="true" @oncontextmenu="(e) => OpenCommunityMenu(e, community)">
            @community.Name
        </a>
    }
    </div>
}

<div class="community-list-item cl-add" @onclick="CreateCommunity">
    +
</div>

@if (showCommunityMenu && communityForMenu != null)
{
    <div class="menu-backdrop" @onclick="CloseCommunityMenu" @oncontextmenu="CloseCommunityMenu" @oncontextmenu:preventDefault="true">
        <div class="community-context-menu" style="@($"top: {communityMenuY}px; left: {communityMenuX}px;")">
            @if (PermService.CanManageCommunity(currMembership))
            {
                <div class="menu-edit-btn" @onclick="OpenEditCommunityModal">Edit</div>
                @if (currMembership.Role == Roles.Owner)
                {
                    <div class="menu-del-btn" @onclick="OpenDeleteCommunityModal">Delete</div>
                }
            }
            @if (PermService.CanLeaveCommunity(currMembership))
            {
                <div class="menu-del-btn" @onclick="OpenLeaveCommunityModal">Leave</div>
            }
        </div>
    </div>
}

@if (showEditCommunityModal)
{
    <div class="modal-backdrop" @onmousedown="CloseEditCommunityModal">
        <div class="com-modal edit-modal" @onmousedown:stopPropagation="true">
            <h5>Edit Community</h5>
            <div class="com-modal-container">
                <div class="com-modal-nav">
                    <div class="@(comModalHeader == "Overview" ? "active" : "")" @onclick="ShowModalOverview">Overview</div>
                    <div class="@(comModalHeader == "Member Report" ? "active" : "")" @onclick="() => ShowModalMemberReport(communityForMenu.Id)">Member Report</div>
                </div>
                <div class="com-modal-main">
                    <div class="report-modal-header">
                        <span class="report-header">@comModalHeader</span>
                        @if (comModalHeader == "Member Report")
                        {
                            <span class="report-time">Generated at @reportGeneratedAt</span>
                        }
                    </div>
                    <div class="com-modal-content">
                        @if (showModalOverview)
                        {
                            <p>Community name</p>
                            <input type="text" class="community-name-input" @bind="@newComName" />
                            <div class="modal-btns">
                                <span class="modal-can-btn" @onclick="CloseEditCommunityModal">Cancel</span>
                                <span class="modal-save-btn" @onclick="() => SaveCommunityEdits(communityForMenu)">Save</span>
                                @if (currMembership.Role == Roles.Owner)
                                {
                                    <span class="modal-del-btn" @onclick="OpenDeleteCommunityModal">Delete</span>
                                }
                            </div>
                        }
                        else if (showModalMemberReport)
                        {
                            <table class="report-table">
                                <thead>
                                    <tr class="report-h-row">
                                        <th class="report-h-col">Username</th>
                                        <th class="report-h-col">Role</th>
                                        <th class="report-h-col">Joined At</th>
                                        <th class="report-h-col">Message Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in memberReportItems)
                                    {
                                        <tr class="report-row">
                                            <td class="report-col-l">@item.Username</td>
                                            <td class="report-role-td">
                                                @if (item.Role == currMembership.Role || item.Role == Roles.Owner)
                                                {
                                                    @item.Role
                                                }
                                                else
                                                {
                                                    <select value="@item.Role"
                                                        @onchange="async e => await UpdateMemberRole(item.UserId, communityForMenu.Id, e.Value?.ToString())">
                                                        <option value="Member" selected="@(item.Role == Roles.Member)">Member</option>
                                                        <option value="Moderator" selected="@(item.Role == Roles.Moderator)">Moderator</option>
                                                    </select>
                                                }
                                            </td>
                                            <td class="report-col-c">@item.JoinedAt.ToString("MM-dd-yyyy")</td>
                                            <td class="report-col-r">@item.MessageCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteCommunityModal)
{
    <div class="modal-backdrop" @onmousedown="CloseDeleteCommunityModal">
        <div class="com-modal" @onmousedown:stopPropagation="true">
            <p>Are you sure you want to delete <b>@communityForMenu.Name</b>?</p>
            <div class="modal-btns">
                <span class="modal-can-btn" @onclick="CloseDeleteCommunityModal">Cancel</span>
                <span class="modal-del-btn" @onclick="() => DeleteCommunity(communityForMenu)">Delete</span>
            </div>
        </div>
    </div>
}

@if (showLeaveCommunityModal)
{
    <div class="modal-backdrop" @onmousedown="CloseLeaveCommunityModal">
        <div class="com-modal" @onmousedown:stopPropagation="true">
            <p>Are you sure you want to leave <b>@communityForMenu.Name</b>?</p>
            <div class="modal-btns">
                <span class="modal-can-btn" @onclick="CloseLeaveCommunityModal">Cancel</span>
                <span class="modal-del-btn" @onclick="() => LeaveCommunity(communityForMenu)">Leave</span>
            </div>
        </div>
    </div>
}


@code {

    private Guid? ActiveCommunityId;

    ClaimsPrincipal? cp;
    ApplicationUser? user;
    private string? userId;
    private Membership? currMembership;
    private string newComName = "";

    private bool showEditCommunityModal;
    private bool showDeleteCommunityModal;
    private bool showLeaveCommunityModal;

    private bool showCommunityMenu;
    private double communityMenuX;
    private double communityMenuY;
    private Community communityForMenu = new();

    private bool showModalOverview;
    private bool showModalMemberReport;
    private string comModalHeader = "Overview";
    private List<MemberReportItem> memberReportItems = new();
    private string reportGeneratedAt = "";

    protected override async Task OnParametersSetAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        cp = authState.User;

        if (cp.Identity?.IsAuthenticated == true)
        {
            userId = cp.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }

        user = await db.Users.FirstOrDefaultAsync(u => u.Id == userId);
    }

    private async Task UpdateMemberRole(string userId, Guid communityId, string newRole)
    {
        if (string.IsNullOrWhiteSpace(newRole)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        Membership? currMembership = await db.Memberships.FirstOrDefaultAsync(m => m.UserId == userId && m.CommunityId == communityId);

        if (currMembership == null || currMembership.Role == Roles.Owner) return;

        currMembership.Role = newRole;
        await db.SaveChangesAsync();

        memberReportItems = await MemRepService.GetMemberReport(communityId);
    }

    private void ShowModalOverview()
    {
        showModalOverview = true;
        showModalMemberReport = false;
        comModalHeader = "Overview";
        memberReportItems.Clear();
    }

    private async Task ShowModalMemberReport(Guid communityId)
    {
        showModalMemberReport = true;
        showModalOverview = false;
        comModalHeader = "Member Report";
        reportGeneratedAt = DateTime.UtcNow.ToString("g");
        memberReportItems = await MemRepService.GetMemberReport(communityId);
    }

    private async Task OpenCommunityMenu(MouseEventArgs e, Community community)
    {
        communityForMenu = community;
        communityMenuX = e.ClientX;
        communityMenuY = e.ClientY;

        using var db = DbFactory.CreateDbContext();
        currMembership = await db.Memberships.FirstOrDefaultAsync(m =>
            m.UserId == userId &&
            m.CommunityId == community.Id);

        showCommunityMenu = true;
    }

    private async Task SaveCommunityEdits(Community community)
    {
        using var db = DbFactory.CreateDbContext();
        Community? c = await db.Communities.FindAsync(community.Id);

        if (community != null && !string.IsNullOrWhiteSpace(newComName))
        {
            c.Name = newComName.Trim();
            await db.SaveChangesAsync();
            await LoadUserCommunities();
            newComName = "";
            CloseEditCommunityModal();
        }
    }

    private async Task DeleteCommunity(Community community)
    {
        using var db = DbFactory.CreateDbContext();

        if (community != null)
        {
            db.Communities.Remove(community);
            await db.SaveChangesAsync();
            await LoadUserCommunities();
        }
        if (community.Id == communityForMenu.Id)
        {
            Nav.NavigateTo("");
        }
        CloseDeleteCommunityModal();
    }

    private async Task LeaveCommunity(Community community)
    {
        using var db = DbFactory.CreateDbContext();
        Membership? membership = await db.Memberships.FirstOrDefaultAsync(m => m.CommunityId == community.Id && m.UserId == userId);

        if (community != null)
        {
            db.Memberships.Remove(membership);
            await db.SaveChangesAsync();
            await LoadUserCommunities();
        }
        if (community.Id == ActiveCommunityId)
        {
            Nav.NavigateTo("");
        }
        CloseLeaveCommunityModal();
    }

    private void CloseLeaveCommunityModal()
    {
        showLeaveCommunityModal = false;
    }

    private void OpenLeaveCommunityModal()
    {
        CloseDeleteCommunityModal();
        CloseEditCommunityModal();
        CloseCommunityMenu();
        showLeaveCommunityModal = true;
    }

    private void CloseCommunityMenu()
    {
        showCommunityMenu = false;
    }

    private void CloseEditCommunityModal()
    {
        showEditCommunityModal = false;
        memberReportItems.Clear();
    }

    private void CloseDeleteCommunityModal()
    {
        showDeleteCommunityModal = false;
    }

    private void OpenEditCommunityModal()
    {
        CloseDeleteCommunityModal();
        CloseCommunityMenu();
        showEditCommunityModal = true;
        ShowModalOverview();
    }

    private void OpenDeleteCommunityModal()
    {
        CloseCommunityMenu();
        CloseEditCommunityModal();
        showDeleteCommunityModal = true;
    }

    protected override void OnInitialized()
    {
        SetActiveCommunityFromUrl();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SetActiveCommunityFromUrl();
        InvokeAsync(StateHasChanged);
        CloseCommunityMenu();
    }

    private void SetActiveCommunityFromUrl()
    {
        string relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        string[] parts = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2 && parts[0].Equals("channels", StringComparison.OrdinalIgnoreCase) &&
        Guid.TryParse(parts[1], out Guid communityId))
        {
            ActiveCommunityId = communityId;
        }
        else
        {
            ActiveCommunityId = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CommunityState.OnChange += StateHasChanged;
        if (!CommunityState.UserCommunities.Any())
        {
            await LoadUserCommunities();
        }
    }

    private async Task LoadUserCommunities()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId)) return;

        using var db = await DbFactory.CreateDbContextAsync();

        var communities = await db.Memberships
            .Where(m => m.UserId == userId)
            .Select(m => m.Community)
            .ToListAsync();

        CommunityState.SetCommunities(communities);
    }

    public void Dispose()
    {
        CommunityState.OnChange -= StateHasChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    public async Task CreateCommunity()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        if (userId == null) return;

        Community community = new()
        {
            Name = $"{user!.UserName}'s Community",
            Description = "This is a new community created at " + DateTime.Now.ToString("HH:mm:ss"),
            OwnerId = userId,
            CreatedAt = DateTime.UtcNow
        };

        Membership membership = new()
        {
            UserId = userId,
            Community = community,
            Role = Roles.Owner,
            JoinedAt = DateTime.UtcNow
        };

        db.Communities.Add(community);
        db.Memberships.Add(membership);
        await db.SaveChangesAsync();

        await LoadUserCommunities();

        Channel channel = new()
        {
            Name = "General",
            CommunityId = community.Id,
            Community = community,
            CreatedAt = DateTime.UtcNow
        };
        db.Channels.Add(channel);
        await db.SaveChangesAsync();

        Nav.NavigateTo($"/channels/{community.Id}/{channel.Id}");
    }

}