@page "/channels/{CommunityId:guid}"
@page "/channels/{CommunityId:guid}/{CurrentChannelId:guid}"
@implements IDisposable

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject MessagingService MessageService
@inject MessageRealtimeService MessageRealtime
@inject UserRealtimeService UserRealtime
@inject ErrorService ErrorService
@inject MessageStateService MessageState
@inject ChannelStateService ChannelState
@inject CommunityStateService CommunityState
@inject IHubContext<MessageHub> MessageHubContext


<PageTitle>@pageTitle</PageTitle>

<div class="channels-page">

    <div class="channel-list-outer">
        <div class="community-menu">
            @if (community != null)
            {
                @community.Name
            }
            else
            {
                <div>Community not found</div>
            }
        </div>

        <div class="channel-list-inner">
            <ChannelList CommunityId="CommunityId" />
        </div>
    </div>

    <div class="channel-content-outer">
        <div class="channel-titlebar">
            @if (channel == null)
            {
                <span>Channel Not Found</span>
            } else
            {
                <span>@channel.Name</span>
            }
            <div class="search-input-container">
                <input class="search-input" type="text" placeholder="Search" @bind="@searchText" @bind:event="oninput" @onkeydown="HandleSearch" />
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <button class="clear-search-btn" @onclick="HardClearSearch">x</button>
                }
            </div>
        </div>

        @if (community == null || channel == null || currMembership == null)
        {
            <div>Loading...</div>
        }
        else
        {
            <div class="channel-content">
                @if (channel != null)
                {
                    <div class="channel-view">
                        <div class="message-list-outer">
                            <div class="message-list-inner">
                                @foreach (MessageDto message in MessageState.Messages)
                                {
                                    <div class="message">
                                        @if (CanEditMessage(message) || CanDeleteMessage(message))
                                        {
                                            <div class="message-menu">
                                                @if (CanEditMessage(message))
                                                {
                                                    <div class="message-edit"
                                                         @onclick="() => EditMessage(message)">
                                                        Edit
                                                    </div>
                                                }
                                                @if (CanDeleteMessage(message))
                                                {
                                                    <div class="message-delete"
                                                         @onclick="() => OpenDeleteModal(message.Id)">
                                                        Delete
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="message-author-icon">
                                        </div>
                                        <div class="message-header">
                                            <span class="message-author-name">@message.UserName</span>
                                            @if (message.UpdatedAt == null)
                                            {
                                                <span class="message-timestamp">@message.CreatedAt</span>
                                            }
                                            else
                                            {
                                                <span class="message-timestamp">@message.UpdatedAt</span>
                                            }
                                        </div>

                                        @if (editingMessageId == message.Id)
                                        {
                                            <div class="message-edit-area">
                                                <textarea @ref="editTextArea"
                                                          @bind="editedMessageText"
                                                          @bind:event="oninput"
                                                          @onkeydown="(KeyboardEventArgs e) => HandleEditKey(message.Id, e)"></textarea>
                                                <div class="edit-actions">
                                                    <span @onclick="CancelEdit">Cancel</span>
                                                    <span class="message-edit-save"
                                                          @onclick="() => SaveEdit(message.Id)">Save</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="message-content">
                                                @message.Content
                                                @if (message.UpdatedAt != null)
                                                {
                                                    <span class="message-edited"> (edited)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="channel-input">
                            <textarea type="text"
                                      @bind="@messageText"
                                      @onkeydown="SendMessage"
                                      @bind:event="oninput"
                                      placeholder="Message @channel.Name"
                                      spellcheck="true" />
                        </div>
                    </div>
                }
            </div>

            @if (showMemberList)
            {
                <div class="member-list">
                    <MemberList CommunityId="CommunityId" ChannelId="CurrentChannelId" />
                </div>
            }

            @if (showSearchContent)
            {
                <div class="search-backdrop" @onmousedown="LightClearSearch"></div>

                <div class="search-list" @onmousedown:stopPropagation="true">
                    <SearchList CommunityId="CommunityId" searchTerm="@searchText" />
                </div>
            }
        }
    </div>
    

</div>

@if (showDeleteModal)
{
    <div class="modal-backdrop" @onclick="CloseDeleteModal">
        <div class="delete-modal" @onclick:stopPropagation="true">
            <h5>Delete Message</h5>
            <p>Are you sure you want to delete this message? This cannot be undone.</p>
            <div class="del-modal-btns">
                <span class="del-modal-can-btn" @onclick="CloseDeleteModal">Cancel</span>
                <span class="del-modal-del-btn" @onclick="() => DeleteMessage(deleteMessageId)">Delete</span>
            </div>
        </div>
    </div>
}


@code {

    [Parameter]
    public Guid CommunityId { get; set; }

    [Parameter]
    public Guid CurrentChannelId { get; set; }

    private string pageTitle => community is not null ? $"{community!.Name}" : "Error: Community Not Found";

    private Channel? channel;
    private Community? community;

    private Membership? currMembership;

    private string? messageText;

    ClaimsPrincipal? cp;
    private string? userId;

    ApplicationUser? user;

    private Guid? editingMessageId;
    private string editedMessageText = "";

    private ElementReference editTextArea;

    private bool showDeleteModal = false;
    private Guid deleteMessageId;

    private bool showMemberList = true;
    private bool showSearchContent = false;
    private string? searchText;
    private Guid subscribedChannelId = Guid.Empty;
    private Guid userProfileSubscriptionCommunityId = Guid.Empty;
    private IDisposable? userProfileSubscription;


    protected override async Task OnParametersSetAsync()
    {
        SubscribeToUserProfileUpdates();

        using var db = await DbFactory.CreateDbContextAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        cp = authState.User;

        if (cp.Identity?.IsAuthenticated == true)
        {
            userId = cp.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }

        user = await db.Users.FirstOrDefaultAsync(u => u.Id == userId);

        if (CurrentChannelId == Guid.Empty)
        {
            Channel? firstChannel = await db.Channels
            .Where(c => c.CommunityId == CommunityId)
            .OrderBy(c => c.CreatedAt)
            .FirstOrDefaultAsync();

            if (firstChannel != null)
            {
                Nav.NavigateTo($"/channels/{CommunityId}/{firstChannel.Id}");
                return;
            }
        }

        await CommunityState.LoadUserCommunitiesAsync(AuthStateProvider);
        community = CommunityState.GetCommunity(CommunityId);
        if (community is null)
        {
            community = await db.Communities.FirstOrDefaultAsync(c =>
            c.Id == CommunityId);
        }

        await ChannelState.LoadChannelsAsync(AuthStateProvider, CommunityId);
        channel = ChannelState.GetChannel(CurrentChannelId);
        if (channel is null)
        {
            channel = await db.Channels.FirstOrDefaultAsync(c =>
            c.Id == CurrentChannelId &&
            c.CommunityId == CommunityId);
        }

        await MessageState.LoadMessagesAsync(CurrentChannelId);
        subscribedChannelId = CurrentChannelId;

        currMembership = await db.Memberships.FirstOrDefaultAsync(m =>
            m.UserId == userId &&
            m.CommunityId == CommunityId);
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchText))
        {
            showMemberList = false;
            showSearchContent = true;
        }
        else if (e.Key == "Enter" && string.IsNullOrWhiteSpace(searchText))
        {
            ShowMemberList();
        }

        if (e.Key == "Escape" && showSearchContent == true)
        {
            searchText = "";
            ShowMemberList();
        }
    }

    private void LightClearSearch()
    {
        showMemberList = true;
        showSearchContent = false;
    }

    private void HardClearSearch()
    {
        searchText = "";
        showMemberList = true;
        showSearchContent = false;
    }

    private void ShowMemberList()
    {
        showMemberList = true;
        showSearchContent = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (editingMessageId != null)
        {
            await editTextArea.FocusAsync();
        }
    }

    private void OpenDeleteModal(Guid id)
    {
        showDeleteModal = true;
        deleteMessageId = id;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
    }

    private async Task SendMessage(KeyboardEventArgs e)
    {
        try
        {
            if (e.Key == "Enter" && !e.ShiftKey)
            {
                if (string.IsNullOrWhiteSpace(messageText) || channel == null || userId == null) return;
                MessageDto? message = await MessageService.SendMessageAsync(CurrentChannelId, messageText, userId);
                if (message is null) return;

                MessageRealtime.NotifyMessageCreated(message);
                await MessageHubContext.Clients
                    .Group(MessageHub.GetChannelGroupName(message.ChannelId))
                    .SendAsync("MessageCreated", message);
                messageText = "";
            }
        }
        catch (Exception ex)
        {
            await ErrorService.ShowErrorAsync("Error sending message.");
            Console.WriteLine($"Error sending message: {ex.Message}");
            return;
        }
    }

    private void EditMessage(MessageDto m)
    {
        editingMessageId = m.Id;
        editedMessageText = m.Content;
    }

    private void CancelEdit()
    {
        editingMessageId = null;
        editedMessageText = "";
    }

    private async Task HandleEditKey(Guid id, KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SaveEdit(id);
        }

        if (e.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private async Task SaveEdit(Guid id)
    {
        try
        {
            if (userId is null) return;

            MessageDto? message = await MessageService.SaveEditAsync(id, editedMessageText, userId);
            if (message is null)
            {
                CancelEdit();
                return;
            }

            MessageRealtime.NotifyMessageEdited(message);
            await MessageHubContext.Clients
                .Group(MessageHub.GetChannelGroupName(message.ChannelId))
                .SendAsync("MessageEdited", message);
            editingMessageId = null;
            editedMessageText = "";
        }
        catch (Exception e)
        {
            await ErrorService.ShowErrorAsync("Error saving message.");
            Console.WriteLine($"Error saving message: {e.Message}");
            return;
        }
    }

    private async Task DeleteMessage(Guid id)
    {
        try
        {
            if (userId is null) return;

            DeletedMessageDto? message = await MessageService.DeleteMessageAsync(id, userId);
            if (message is null) return;

            MessageRealtime.NotifyMessageDeleted(message);
            await MessageHubContext.Clients
                .Group(MessageHub.GetChannelGroupName(message.ChannelId))
                .SendAsync("MessageDeleted", message);
            CloseDeleteModal();
        }
        catch (Exception e)
        {
            await ErrorService.ShowErrorAsync("Error deleting message.");
            Console.WriteLine($"Error deleting message: {e.Message}");
            return;
        }
    }

    protected override void OnInitialized()
    {
        ChannelState.OnChange += HandleChannelStateChanged;
        CommunityState.OnChange += HandleCommunityStateChanged;
        MessageRealtime.MessageCreated += HandleMessageCreated;
        MessageRealtime.MessageEdited += HandleMessageEdited;
        MessageRealtime.MessageDeleted += HandleMessageDeleted;
    }

    private bool CanEditMessage(MessageDto message)
    {
        return currMembership?.UserId == message.UserId;
    }

    private bool CanDeleteMessage(MessageDto message)
    {
        return currMembership?.Role == Roles.Owner ||
            currMembership?.Role == Roles.Moderator ||
            currMembership?.UserId == message.UserId;
    }

    private void HandleMessageCreated(MessageDto message)
    {
        if (message.ChannelId != subscribedChannelId) return;

        _ = InvokeAsync(() =>
        {
            MessageState.AddMessage(message);
            StateHasChanged();
        });
    }

    private void HandleMessageEdited(MessageDto message)
    {
        if (message.ChannelId != subscribedChannelId) return;

        _ = InvokeAsync(() =>
        {
            MessageState.UpdateMessage(message);
            StateHasChanged();
        });
    }

    private void HandleMessageDeleted(DeletedMessageDto message)
    {
        if (message.ChannelId != subscribedChannelId) return;

        _ = InvokeAsync(() =>
        {
            MessageState.RemoveMessage(message.Id);
            StateHasChanged();
        });
    }

    private void HandleUserProfileUpdated(UserProfileUpdatedDto user)
    {
        _ = InvokeAsync(() =>
        {
            MessageState.UpdateUserName(user.UserId, user.UserName);
            StateHasChanged();
        });
    }

    private void SubscribeToUserProfileUpdates()
    {
        if (userProfileSubscriptionCommunityId == CommunityId) return;

        userProfileSubscription?.Dispose();
        userProfileSubscription = UserRealtime.SubscribeToCommunity(CommunityId, HandleUserProfileUpdated);
        userProfileSubscriptionCommunityId = CommunityId;
    }

    private void HandleChannelStateChanged()
    {
        channel = ChannelState.GetChannel(CurrentChannelId);
        InvokeAsync(StateHasChanged);
    }

    private void HandleCommunityStateChanged()
    {
        community = CommunityState.GetCommunity(CommunityId);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChannelState.OnChange -= HandleChannelStateChanged;
        CommunityState.OnChange -= HandleCommunityStateChanged;
        MessageRealtime.MessageCreated -= HandleMessageCreated;
        MessageRealtime.MessageEdited -= HandleMessageEdited;
        MessageRealtime.MessageDeleted -= HandleMessageDeleted;
        userProfileSubscription?.Dispose();
    }

}
