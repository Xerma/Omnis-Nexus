@page "/"
@attribute [Authorize]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject CommunityStateService CommunityState


<PageTitle>Home</PageTitle>

<div class="home-container">
    <div class="user-stats">
        <div class="stat-header">
            <span>Statistics</span>
        </div>

        <div class="stat-list">
            <Statistic statName="Communities Joined" statVal="@comsJoinedInt" />
            <Statistic statName="Communities Owned" statVal="@comsOwnedInt" />
            <Statistic statName="Messages Sent" statVal="@messagesSentInt" />
            <Statistic statName="Messages Edited" statVal="@messagesEditedInt" />
        </div>

        <form action="Account/Logout" method="post" class="logout-form">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />

            <button type="submit" class="logout-button">
                Logout
            </button>
        </form>
    </div>

    <div class="com-container">
        <div class="com-header">
            <span>Communities</span>
        </div>
        <div class="all-coms">
            @if (allCommunities != null)
            {
                @foreach (var community in allCommunities!)
                {
                    <div @onclick="() => JoinOrNavCommunity(community.Id)" class="com-listing">
                        <span class="com-name">@community.Name</span>
                        <span class="com-count">@community.MemberCount</span>
                    </div>
                }
            }
        </div>
    </div>
</div>


@code {

    private List<CommunityListItem>? allCommunities;
    private string? userId;
    ClaimsPrincipal? cp;
    ApplicationUser? user;

    private string? currentUrl;

    private int comsJoinedInt;
    private int messagesSentInt;
    private int comsOwnedInt;
    private int messagesEditedInt;


    protected override void OnInitialized()
    {
        currentUrl = Nav.ToBaseRelativePath(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = Nav.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        cp = authState.User;

        if (cp.Identity?.IsAuthenticated == true)
        {
            userId = cp.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }

        user = await db.Users.FirstOrDefaultAsync(u => u.Id == userId);

        allCommunities = await db.Communities
        .Select(c => new CommunityListItem
        {
            Id = c.Id,
            Name = c.Name,
            MemberCount = c.Memberships.Count()
        })
        .ToListAsync();

        comsJoinedInt = await db.Communities
        .Where(c => c.Memberships.Any(m => m.UserId == userId))
        .CountAsync();

        messagesSentInt = await db.Messages
        .Where(m => m.UserId == userId)
        .CountAsync();

        comsOwnedInt = await db.Communities
        .Where(c => c.OwnerId == userId)
        .CountAsync();

        messagesEditedInt = await db.Messages
        .Where(m => m.UpdatedAt != null)
        .Where(m => m.UserId == userId)
        .CountAsync();
    }

    private async Task JoinOrNavCommunity(Guid communityId)
    {
        using var db = await DbFactory.CreateDbContextAsync();

        Membership? membership = await db.Memberships.FirstOrDefaultAsync(m => m.UserId == userId && m.CommunityId == communityId);

        if (membership == null)
        {
            Community? community = await db.Communities.FirstOrDefaultAsync(c => c.Id == communityId);

            if (userId == null || community == null) return;

            Membership m = new()
            {
                UserId = userId,
                Community = community,
                Role = Roles.Member,
                JoinedAt = DateTime.UtcNow
            };

            await db.Memberships.AddAsync(m);
            db.SaveChanges();

            var updatedCommunities = await db.Memberships
            .Where(m => m.UserId == userId)
            .Select(m => m.Community)
            .ToListAsync();

            CommunityState.SetCommunities(updatedCommunities);
        }

        Nav.NavigateTo($"/channels/{communityId}");
    }

}